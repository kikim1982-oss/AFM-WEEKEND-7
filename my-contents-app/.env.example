# ============================================
# my-contents-app 환경 변수 템플릿
# 이 파일을 복사해서 .env 로 저장 후 실제 값으로 교체하세요
#   cp .env.example .env
# ============================================

# 서버
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001

# 토스페이먼츠
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_SUCCESS_URL=http://localhost:3001/api/payments/success
TOSS_FAIL_URL=http://localhost:3001/api/payments/fail

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 콘텐츠
CONTENT_BUCKET=contents
DOWNLOAD_URL_EXPIRES_IN=300

# 상품
PRODUCT_NAME=My Contents PNG
PRODUCT_PRICE=4900
PRODUCT_CURRENCY=KRW
